#!/bin/sh -e

# Create the virtual environment and install the dev + docs dependency groups,
# then compile the Zig extension against that interpreter.

if [ -z "$GITHUB_ACTIONS" ]; then
    set -x
fi

uv sync --frozen --all-groups

# Build the Zig extension against the venv's interpreter so `import zloop` works.
./build_ext.sh "$(pwd)/.venv/bin/python"
