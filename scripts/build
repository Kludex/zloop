#!/bin/sh -e

# Compile the Zig core, the CPython extension, and the documentation site.

set -x

# Pure-Zig core unit tests double as the core's build check - they link libc and
# exercise the reactor, timer heap, and ready queue without CPython.
zig build test

# Build the extension against the venv interpreter, then confirm it imports.
./build_ext.sh "$(pwd)/.venv/bin/python"
.venv/bin/python -c "import zloop; print(zloop.new_event_loop())"

# Build the docs so a broken site fails CI before it ever ships.
.venv/bin/python -m zensical build
