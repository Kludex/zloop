#!/bin/sh -e

# Compile the Zig core, the CPython extension, and the documentation site.

set -x

# Pure-Zig core unit tests double as the core's build check - they link libc and
# exercise the reactor, timer heap, and ready queue without CPython.
zig build test

# Rebuild the extension through the hatch-ziglang hook, then confirm it imports.
uv sync --frozen --reinstall-package zloop ${ZLOOP_SYNC_GROUPS:---all-groups}
.venv/bin/python -c "import zloop; print(zloop.new_event_loop())"

# Build the docs so a broken site fails CI before it ever ships. Skippable when
# the docs group isn't installed (e.g. the free-threaded leg, where zensical has
# no free-threaded wheel).
if [ -z "$ZLOOP_SKIP_DOCS" ]; then
    .venv/bin/python -m zensical build
fi
